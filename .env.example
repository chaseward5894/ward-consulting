# ─────────────────────────────────────────────────────────
# Ward Consulting — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────

# Your email address — where new lead notifications will be sent
NOTIFICATION_EMAIL=you@yourdomain.com

# Resend API key — for sending transactional emails
# Sign up free at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Zapier webhook URL — for logging submissions to Google Sheets
# Create a "Catch Hook" Zap at https://zapier.com and paste the URL here
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxxx/xxxxxxxx/
